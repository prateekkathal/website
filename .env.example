# Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile)
# Site key is public (rendered in the browser). Secret key stays server-side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend (https://resend.com/api-keys)
RESEND_API_KEY=
# Verified sender. Until you verify prateekkathal.com in Resend, use onboarding@resend.dev
MAIL_FROM=onboarding@resend.dev
# Where contact submissions are delivered
MAIL_TO=contact@prateekkathal.com
